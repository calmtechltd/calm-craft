{
  "name": "@calmcraft/cli",
  "version": "0.3.0",
  "description": "Local visualizer and branch review for CalmCraft product specs.",
  "keywords": [
    "branch-review",
    "calmcraft",
    "developer-tools",
    "git",
    "specifications"
  ],
  "homepage": "https://github.com/calmtechltd/calm-craft#readme",
  "bugs": {
    "url": "https://github.com/calmtechltd/calm-craft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calmtechltd/calm-craft.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "calmcraft": "dist/cli/index.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "assets",
    "dist",
    "plugin.json",
    "references",
    "skills"
  ],
  "scripts": {
    "build": "pnpm build:ui && pnpm build:cli",
    "build:cli": "tsup --config tsup.config.ts",
    "build:ui": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch scripts/dev.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "license-check": "license-checker scan --failOn AGPL-1.0-or-later AGPL-3.0-or-later GPL-1.0-or-later GPL-2.0-or-later GPL-3.0-or-later SSPL-1.0 --ignoreRootPackageLicense --disableReport",
    "lint": "oxlint .",
    "pack:check": "pnpm build && pnpm pack --dry-run",
    "release:check": "node scripts/verify-release-package.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:unit": "vitest run --exclude 'test/e2e/**'"
  },
  "dependencies": {
    "marked": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@onebeyond/license-checker": "^1.0.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.18.0",
    "oxlint": "^1.14.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
